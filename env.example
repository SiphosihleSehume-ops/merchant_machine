# ==============================================================================
# Merchant & Payment Machine — Frontend Environment Guide (.env.local)
# ==============================================================================
# Setup:
#   1. Copy this file to `.env.local` in the project root:
#        cp env.example .env.local
#   2. Never commit `.env.local` to Git.
#   3. Note: Every variable prefixed with `NEXT_PUBLIC_` is inlined into the
#      browser bundle at build/start time. Do NOT place private keys or secrets here.
#   4. Tip: Running `./run-all.sh` automatically populates `.env.local` for local
#      Hardhat development (Chain ID 31337).
# ==============================================================================

# ---- TEMPORARY TEST MODE ----
# true = skip sign-in and use the backend's demo account (backend needs AUTH_DISABLED=true too).
# Set to false (or remove) to turn authentication back on.
NEXT_PUBLIC_AUTH_DISABLED=false

# ------------------------------------------------------------------------------
# 1. Backend API URL
# ------------------------------------------------------------------------------
# Base URL of the Express + x402 Facilitator backend (must include `/api/v1`).
# Default local backend port is 4000.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# 2. Blockchain Network & Block Explorer
# ------------------------------------------------------------------------------
# Chain ID that MetaMask will switch to when connecting a wallet or signing an
# x402 payment:
#   - 11155111 = Ethereum Sepolia Testnet
#   - 31337    = Local Hardhat Node (`npx hardhat node`)
NEXT_PUBLIC_CHAIN_ID=11155111

# Block explorer transaction prefix used for "View transaction" links on receipts:
NEXT_PUBLIC_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/

# ------------------------------------------------------------------------------
# 3. Deployed TestStablecoin Contract Addresses
# ------------------------------------------------------------------------------
# Copy these 0x addresses from `contracts/deployments/sepolia.json` (for Sepolia)
# or `contracts/deployments/localhost.local.json` (for local Hardhat) after running:
#   cd contracts && npx hardhat run scripts/deploy.ts --network sepolia
#
# Must match `TOKEN_ZARK_ADDRESS`, `TOKEN_USDC_ADDRESS`, and `TOKEN_NGN_ADDRESS`
# in `backend/.env` so EIP-712 / EIP-3009 payment signatures verify.
NEXT_PUBLIC_TOKEN_ZARK_ADDRESS=0x0484eC78F68b01029710e69CCBbF194fD7864F85
NEXT_PUBLIC_TOKEN_USDC_ADDRESS=0xf5f5F5133b92AB1bC94ddDACBe1aA9b8Dd176336
NEXT_PUBLIC_TOKEN_NGN_ADDRESS=0x54F3E1C76aD03E946901c33eebf56fC1375ef37c
