# Copy this file to .env.local and adjust. Never commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are visible in the browser. Do not put secrets in them.

# ---- App ----
NEXT_PUBLIC_APP_NAME="Merchant & Payment Machine"

# ---- Back end ----
# Base URL of the team's API (Java/Spring or whatever the back end uses)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# true = use the placeholder data in lib/data.ts, false = call the API
NEXT_PUBLIC_USE_MOCK_DATA=true

# ---- Display ----
NEXT_PUBLIC_CURRENCY_SYMBOL=R

# ---- Demo merchant (used while mock data is on) ----
NEXT_PUBLIC_DEMO_MERCHANT_NAME="Kasi Corner Shop"
NEXT_PUBLIC_DEMO_SHOP_CODE=RMT6VM
NEXT_PUBLIC_DEMO_BALANCE=259.30

# ---- Payments ----
# If set, the Share Code QR encodes <base>/<shop code> (a pay link) instead of the bare code.
# Leave empty to encode just the shop code.
NEXT_PUBLIC_PAYMENT_LINK_BASE=

# ---- Server-only secrets (add when the back end needs them; no NEXT_PUBLIC_ prefix) ----
# API_SECRET_KEY=
# PAYMENT_PROVIDER_KEY=
