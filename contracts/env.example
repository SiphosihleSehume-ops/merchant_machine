# ==============================================================================
# Merchant & Payment Machine — Smart Contracts Environment Guide (contracts/.env)
# ==============================================================================
# Setup:
#   1. Copy this file to `contracts/.env`:
#        cp contracts/env.example contracts/.env
#   2. Never commit `contracts/.env` to Git.
#   3. Deploy all three EIP-3009 TestStablecoin tokens (ZARK, USDC, NGN):
#        cd contracts
#        npm run deploy:sepolia   # Deploys to Ethereum Sepolia -> deployments/sepolia.json
#        npm run deploy:local     # Deploys to local Hardhat    -> deployments/localhost.local.json
#   4. Copy the printed `TOKEN_ZARK_ADDRESS`, `TOKEN_USDC_ADDRESS`, and
#      `TOKEN_NGN_ADDRESS` values into `backend/.env` and root `.env.local`.
# ==============================================================================

# Ethereum Sepolia JSON-RPC URL (Alchemy, Infura, QuickNode, etc.)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-alchemy-api-key>

# Deployer wallet private key (0x-prefixed 32-byte hex):
#   - Must hold Sepolia ETH to pay deployment gas.
#   - Becomes the `Ownable` owner of ZARK, USDC, and NGN (can call `mint` and `setFaucetAmount`).
#   - Can also be reused as `FACILITATOR_PRIVATE_KEY` in `backend/.env`.
PRIVATE_KEY=0x...

# Optional: Etherscan API key for contract source verification on Sepolia
ETHERSCAN_API_KEY=
