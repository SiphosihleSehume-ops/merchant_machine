# ---- Core ----
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Frontend origin(s), comma separated. Unset = allow all (dev only)
CORS_ORIGIN=http://localhost:3000
# Used in verification email links
APP_URL=http://localhost:3000

# ---- Email (Nodemailer SMTP) ----
# Without SMTP_HOST (and NODE_ENV != production) the verification link is printed to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=app-password
MAIL_FROM="Merchant Machine <you@example.com>"

# ---- Chain (Ethereum Sepolia) ----
CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>
# Relayer wallet for the self-hosted x402 facilitator. Pays gas to settle payments; needs Sepolia ETH.
FACILITATOR_PRIVATE_KEY=0x...

# ---- Tokens (from contracts/deployments/sepolia.json) ----
TOKEN_ZARK_ADDRESS=0x...
TOKEN_USDC_ADDRESS=0x...
TOKEN_NGN_ADDRESS=0x...

# ---- Demo settings ----
# ZAR per 1 USDC (ZARK is 1:1 with ZAR)
ZAR_PER_USD=18.50
# Hours a merchant has to approve/decline a reversal request
REVERSAL_APPROVAL_HOURS=24
