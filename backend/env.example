# ==============================================================================
# Merchant & Payment Machine — Backend Environment Guide (backend/.env)
# ==============================================================================
# Setup:
#   1. Copy this file to `backend/.env`:
#        cp backend/env.example backend/.env
#   2. Never commit `backend/.env` to Git (it contains database credentials,
#      JWT secrets, SMTP passwords, and the facilitator relayer private key).
#   3. Apply Prisma migrations after setting DATABASE_URL:
#        cd backend && npx prisma migrate deploy
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Database (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# PostgreSQL connection string:
#   - For Neon (https://neon.tech): copy the connection string from your Neon
#     dashboard. Note: do NOT include `channel_binding=require`; `backend/src/lib/prisma.ts`
#     automatically normalizes timeouts and connection limits for Neon.
#   - For local Docker Postgres (`./run-all.sh --local-db`):
#     postgresql://postgres:postgres@localhost:5432/merchant_machine?schema=public
DATABASE_URL="postgresql://user:pass@ep-example.eu-west-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&connection_limit=5"

# Random secret used to sign 24-hour JWT session tokens (generate with `openssl rand -hex 32`)
JWT_SECRET="change-me-to-a-long-random-string"

# Port the Express API listens on
PORT=4000

# Allowed browser origin(s) for CORS (comma-separated). Exposes x402 headers.
CORS_ORIGIN="http://localhost:3000"

# Public URL of the Next.js frontend (used in verification email links)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Email Verification & 6-Digit OTP (Nodemailer Gmail SMTP)
# ------------------------------------------------------------------------------
# How to set up Gmail SMTP for `queenofleonida@gmail.com`:
#   1. Sign in to Google Account settings: https://myaccount.google.com/security
#   2. Enable 2-Step Verification if not already enabled.
#   3. Open App Passwords: https://myaccount.google.com/apppasswords
#   4. Create an App Password (e.g. "Merchant Machine") and copy the 16-character
#      code into `SMTP_PASS` below (spaces are stripped automatically).
#
# Note: While `SMTP_PASS` is left as `app-password` in development, Nodemailer
# automatically provisions a temporary Ethereal SMTP inbox and logs the preview URL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=queenofleonida@gmail.com
SMTP_PASS=app-password
MAIL_FROM="Merchant Machine <queenofleonida@gmail.com>"

# ------------------------------------------------------------------------------
# 3. Blockchain & Self-Hosted x402 Facilitator
# ------------------------------------------------------------------------------
# Chain ID:
#   - 11155111 = Ethereum Sepolia Testnet
#   - 31337    = Local Hardhat Node (`npx hardhat node`)
CHAIN_ID=11155111

# JSON-RPC endpoint for the active chain (e.g. Alchemy/Infura Sepolia URL, or
# http://127.0.0.1:8545 for local Hardhat)
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/<your-alchemy-api-key>"

# Private key of the facilitator relayer / platform treasury wallet:
#   - Submits customer EIP-3009 `transferWithAuthorization` signatures on-chain
#     so customers pay zero gas.
#   - Executes on-chain refund transfers when a merchant approves a reversal.
#   - Needs Sepolia ETH for gas (on local Hardhat, use Account #0 below).
FACILITATOR_PRIVATE_KEY=0x...

# ------------------------------------------------------------------------------
# 4. Deployed TestStablecoin Contract Addresses
# ------------------------------------------------------------------------------
# Copy from `contracts/deployments/sepolia.json` (or `localhost.local.json`).
# Must match the `NEXT_PUBLIC_TOKEN_*_ADDRESS` values in the frontend `.env.local`.
TOKEN_ZARK_ADDRESS=0x0484eC78F68b01029710e69CCBbF194fD7864F85
TOKEN_USDC_ADDRESS=0xf5f5F5133b92AB1bC94ddDACBe1aA9b8Dd176336
TOKEN_NGN_ADDRESS=0x54F3E1C76aD03E946901c33eebf56fC1375ef37c

# ------------------------------------------------------------------------------
# 5. FX, Reversal Window & Webhooks
# ------------------------------------------------------------------------------
# Demo conversion rate: ZAR per 1 USDC (ZARK is pegged 1:1 to ZAR).
# Persisted on `Settlement.fxSnapshot` at settlement time.
ZAR_PER_USD=18.50

# Hours a merchant has to approve or decline a customer reversal request before
# it automatically expires (`FAILED`).
REVERSAL_APPROVAL_HOURS=24

# Optional webhook endpoint to receive signed JSON POST events (`payment.settled`,
# `payment.failed`, `reversal.requested`, `reversal.declined`, `reversal.completed`, etc.)
# WEBHOOK_URL=https://example.com/webhooks/merchant-machine
